# ═══ Configuration de PRODUCTION — copiée en deploy/.env sur le serveur ═══
# Créée automatiquement par `bash deploy/init-env.sh` (mots de passe générés).
# Ne jamais commiter deploy/.env, ne jamais le copier-coller dans une discussion.

# ─── Domaine ───
# Sans nom de domaine : <IP avec des tirets>.sslip.io (ex. 152-70-10-20.sslip.io)
DOMAIN=
# Email pour le certificat HTTPS (avertissements d'expiration Let's Encrypt)
ACME_EMAIL=

# ─── Générés par init-env.sh ───
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
JWT_EXPIRATION=24h
REDIS_DB=0

# ─── IA (Google AI Studio → clé API) ───
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=4096
AI_THINKING_BUDGET=0
AI_THINKING_BUDGET_GENDERED=512

# ─── Garde-fous de coût ───
GLOBAL_DAILY_AI_BUDGET_USD=5
GLOBAL_DAILY_SMS_LIMIT=50
AI_PRICE_INPUT_PER_M_USD=0.30
AI_PRICE_OUTPUT_PER_M_USD=2.50
SMS_COST_USD=0.08
ADMIN_ALERT_EMAIL=
RATE_LIMIT_GLOBAL_PER_MINUTE=300

# ─── Emails (SMTP) ───
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# ─── Connexion Google ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── SMS (optionnel) ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ─── Paiement Stripe (sk_test_… pour les essais, sk_live_… pour de vrais paiements) ───
STRIPE_SECRET_KEY=
# Webhook : https://<DOMAIN>/api/v1/billing/webhook
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PORTAL_CONFIGURATION_ID=

# ─── Site (valeurs PUBLIQUES, intégrées au JavaScript) ───
VITE_GOOGLE_CLIENT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
