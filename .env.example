# ==================== Database ====================
# Pour Docker: postgresql://humlinker_user:humlinker_password@postgres:5432/humlinker_db
# Pour Local: postgresql://humlinker_user:humlinker_password@localhost:5432/humlinker_db
DATABASE_URL=postgresql://humlinker_user:humlinker_password@localhost:5432/humlinker_db

# ==================== PostgreSQL ====================
POSTGRES_USER=humlinker_user
POSTGRES_PASSWORD=humlinker_password
POSTGRES_DB=humlinker_db
POSTGRES_PORT=5432

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== JWT ====================
JWT_SECRET=your_jwt_secret_key_here_change_it_in_production
JWT_EXPIRATION=24h

# ==================== Google OAuth ====================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ==================== Mail Service (SMTP) ====================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@humlinker.com

# ==================== SMS Service (Twilio) ====================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ==================== App ====================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
