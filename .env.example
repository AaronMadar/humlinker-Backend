# ==================== Database ====================
# Pour Docker: postgresql://humlinker_user:humlinker_password@postgres:5432/humlinker_db
# Pour Local: postgresql://humlinker_user:humlinker_password@localhost:5432/humlinker_db
DATABASE_URL=postgresql://humlinker_user:humlinker_password@localhost:5432/humlinker_db

# ==================== PostgreSQL ====================
POSTGRES_USER=humlinker_user
POSTGRES_PASSWORD=humlinker_password
POSTGRES_DB=humlinker_db
POSTGRES_PORT=5432
 
# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== JWT ====================
# Minimum 32 caractères. Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_change_it_in_production
JWT_EXPIRATION=24h

# ==================== Google OAuth ====================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ==================== Mail Service (SMTP) ====================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=noreply@humlinker.com

# ==================== SMS Service (Twilio) ====================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
# Numéro WhatsApp Business approuvé Twilio (format E.164, sans "whatsapp:" prefix)
TWILIO_WHATSAPP_NUMBER=+1234567890

# ==================== AI (Google Gemini) ====================
GEMINI_API_KEY=your_gemini_api_key

# ==================== Firebase (FCM Push Notifications) ====================
# Récupérer depuis la console Firebase → Paramètres projet → Comptes de service → Générer une clé privée
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Coller la clé privée telle quelle (les \n sont gérés automatiquement)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxxxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"

# ==================== App ====================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# URL(s) du frontend autorisées par le CORS (HTTP + WebSocket), séparées par des virgules.
# En production : obligatoire et en https://. En dev, http://localhost:5173 est ajouté automatiquement.
FRONTEND_URL=https://humlinker.com
# Derrière un reverse proxy (Railway, Render, Nginx…) : nombre de proxies à faire confiance (ex: 1)
# pour que le rate limiting voie la vraie IP du client. Laisser vide en local.
TRUST_PROXY=
# Limite globale de requêtes par IP et par minute
RATE_LIMIT_GLOBAL_PER_MINUTE=300

# ==================== Quotas & protection des coûts ====================
# Les limites de chaque offre (free / pro) sont dans src/modules/billing/plans.config.ts
# Disjoncteur : budget IA max par jour pour toute la plateforme ($). Au-delà, l'IA est suspendue jusqu'à minuit UTC.
GLOBAL_DAILY_AI_BUDGET_USD=20
# Disjoncteur : nombre max de SMS OTP par jour pour toute la plateforme (anti SMS pumping).
GLOBAL_DAILY_SMS_LIMIT=200
# Tarifs servant à estimer les coûts (table usage_records) — à aligner sur vos factures
AI_PRICE_INPUT_PER_M_USD=0.30
AI_PRICE_OUTPUT_PER_M_USD=2.50
SMS_COST_USD=0.08
# Email qui reçoit les alertes (budget atteint, attaque SMS…)
ADMIN_ALERT_EMAIL=

# ==================== Paiement (Stripe) ====================
# Clés : dashboard Stripe → Développeurs → Clés API (sk_test_… en dev, sk_live_… en prod)
STRIPE_SECRET_KEY=
# Secret du webhook (whsec_…) : dashboard → Développeurs → Webhooks, URL https://<api>/api/v1/billing/webhook
# En local : `stripe listen --forward-to localhost:3000/api/v1/billing/webhook` affiche ce secret
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix de l'offre Pro (Produits → Pro → Prix) : price_…
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
