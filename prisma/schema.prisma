generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum UserGender {
  male
  female
  other
}

enum UserAuthProvider {
  local
  google
}

enum UserPlaceholderSource {
  humlinker_invitation
  manual
}

model User {
  id                String                 @id @default(uuid())
  role              UserRole               @default(user)
  gender            UserGender?
  firstName         String?
  lastName          String?
  /// PIN unique de 8 caractères alphanumériques (style BBM). Généré auto à la création.
  /// Partagé par l'utilisateur pour être trouvé sur Humlinker. Non modifiable.
  pin               String                 @unique
  email             String?                @unique
  phoneNumber       String?                @unique
  language          String
  passwordHash      String?
  authProviders     UserAuthProvider[]
  profilePicture    String?
  isEmailVerified   Boolean                @default(false)
  isPhoneVerified   Boolean                @default(false)
  isPlaceholder     Boolean                @default(false)
  placeholderSource UserPlaceholderSource?

  /// Token FCM (Firebase Cloud Messaging) pour les push notifications.
  /// Mis à jour à chaque login / ouverture de l'app.
  fcmToken String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  sentHumlinkers     Humlinker[] @relation("HumlinkerSender")
  receivedHumlinkers Humlinker[] @relation("HumlinkerTarget")

  @@map("users")
}

// ─── Humlinker ────────────────────────────────────────────────────────────────

enum HumlinkerStatus {
  pending  // créé, aucun message envoyé
  active   // au moins un message échangé
  archived // archivé par l'utilisateur
  blocked  // bloqué
}

enum HumlinkerChannel {
  app
  email
}

model Humlinker {
  id       String @id @default(uuid())
  senderId String
  targetId String

  mirrorId    String?         @unique
  isInitiator Boolean         @default(true)
  status      HumlinkerStatus @default(pending)
  blockedBy String?

  communicationChannel HumlinkerChannel @default(app)
  targetContactName    String
  relationshipType     String
  title                String
  senderSnapshot       Json
  targetSnapshot       Json

  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  senderUser   User          @relation("HumlinkerSender", fields: [senderId], references: [id])
  targetUser   User          @relation("HumlinkerTarget", fields: [targetId], references: [id])
  drafts       Draft[]
  chatMessages ChatMessage[]

  @@unique([senderId, targetId])
  @@index([senderId, lastActivityAt(sort: Desc)])
  @@index([targetId, lastActivityAt(sort: Desc)])
  @@index([status])
  @@map("humlinkers")
}

// ─── Draft ────────────────────────────────────────────────────────────────────

model Draft {
  id               String   @id @default(uuid())
  humhlinkerId     String
  objectiveMessage String
  realMessage      String
  version          Int
  isSent           Boolean  @default(false)
  createdAt        DateTime @default(now())

  humlinker Humlinker @relation(fields: [humhlinkerId], references: [id], onDelete: Cascade)

  @@index([humhlinkerId, version(sort: Desc)])
  @@map("drafts")
}

// ─── ChatMessage ──────────────────────────────────────────────────────────────

enum ChatMessageRole {
  user
  ai
  system
}

enum ChatMessageType {
  text
  draft_snapshot
  system
  target_reply
  real_message
}

model ChatMessage {
  id           String          @id @default(uuid())
  humhlinkerId String
  role         ChatMessageRole
  type         ChatMessageType @default(text)
  content      String
  draftId      String?
  createdAt    DateTime        @default(now())

  humlinker Humlinker @relation(fields: [humhlinkerId], references: [id], onDelete: Cascade)

  @@index([humhlinkerId, createdAt(sort: Desc)])
  @@map("chat_messages")
}
