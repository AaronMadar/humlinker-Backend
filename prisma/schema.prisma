generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum UserGender {
  male
  female
  other
}

enum UserAuthProvider {
  local
  google
}

enum UserPlaceholderSource {
  humlinker_invitation
  manual
}

/// Offre de l'utilisateur. Les limites de chaque offre sont dans src/modules/billing/plans.config.ts
enum PlanTier {
  free
  pro
}

model User {
  id                String                 @id @default(uuid())
  role              UserRole               @default(user)
  gender            UserGender?
  firstName         String?
  lastName          String?
  /// PIN unique de 8 caractères alphanumériques (style BBM). Généré auto à la création.
  /// Partagé par l'utilisateur pour être trouvé sur Humlinker. Non modifiable.
  pin               String                 @unique
  email             String?                @unique
  phoneNumber       String?                @unique
  language          String
  passwordHash      String?
  authProviders     UserAuthProvider[]
  profilePicture    String?
  isEmailVerified   Boolean                @default(false)
  isPhoneVerified   Boolean                @default(false)
  isPlaceholder     Boolean                @default(false)
  placeholderSource UserPlaceholderSource?

  /// Token FCM (Firebase Cloud Messaging) pour les push notifications.
  /// Mis à jour à chaque login / ouverture de l'app.
  fcmToken String?

  /// Offre actuelle (free par défaut). Mise à jour par Stripe à l'étape paiement.
  plan          PlanTier  @default(free)
  /// Fin de la période payée — au-delà, l'utilisateur repasse automatiquement en free.
  planExpiresAt DateTime?

  // ─── Stripe ───
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  /// Statut Stripe brut (active, trialing, past_due, canceled…)
  subscriptionStatus   String?
  /// L'utilisateur a demandé la résiliation : Pro jusqu'à currentPeriodEnd puis free
  cancelAtPeriodEnd    Boolean   @default(false)
  /// Début / fin de la période de facturation en cours (ancre les quotas mensuels Pro)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
  /// Compte supprimé (RGPD) : données personnelles effacées, connexion impossible
  deletedAt   DateTime?
  /// Version des sessions : incrémentée par « déconnecter tous mes appareils »,
  /// changement / réinitialisation du mot de passe, suppression du compte.
  /// Tout jeton d'accès portant une autre version est refusé (jwt.strategy.ts).
  tokenVersion Int      @default(0)

  sentHumlinkers     Humlinker[]   @relation("HumlinkerSender")
  receivedHumlinkers Humlinker[]   @relation("HumlinkerTarget")
  usageRecords       UsageRecord[]

  @@map("users")
}

// ─── Humlinker ────────────────────────────────────────────────────────────────

enum HumlinkerStatus {
  pending // créé, aucun message envoyé
  active // au moins un message échangé
  archived // archivé par l'utilisateur
  blocked // bloqué
}

enum HumlinkerChannel {
  app
  email
}

model Humlinker {
  id       String @id @default(uuid())
  senderId String
  targetId String

  mirrorId    String?         @unique
  isInitiator Boolean         @default(true)
  status      HumlinkerStatus @default(pending)
  blockedBy   String?

  communicationChannel HumlinkerChannel @default(app)
  targetContactName    String
  relationshipType     String
  title                String
  senderSnapshot       Json
  targetSnapshot       Json

  lastActivityAt      DateTime  @default(now())
  /// « Effacer la discussion » : messages antérieurs masqués à l'écran pour ce côté,
  /// mais toujours transmis à l'IA comme contexte. null = rien d'effacé.
  historyClearedAt    DateTime?
  /// Résumé des messages trop anciens pour la fenêtre de contexte de l'IA (50 derniers),
  /// mis à jour au fil de l'eau : l'IA garde le fil des longues conversations.
  contextSummary      String?
  /// Date du dernier message couvert par contextSummary
  contextSummaryUntil DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  senderUser   User          @relation("HumlinkerSender", fields: [senderId], references: [id])
  targetUser   User          @relation("HumlinkerTarget", fields: [targetId], references: [id])
  drafts       Draft[]
  chatMessages ChatMessage[]

  @@unique([senderId, targetId])
  @@index([senderId, lastActivityAt(sort: Desc)])
  @@index([targetId, lastActivityAt(sort: Desc)])
  @@index([status])
  @@map("humlinkers")
}

// ─── Draft ────────────────────────────────────────────────────────────────────

model Draft {
  id               String   @id @default(uuid())
  humhlinkerId     String
  objectiveMessage String
  realMessage      String
  /// Le message transmis, dans la langue de l'expéditeur (= realMessage si même langue).
  /// C'est ce que l'expéditeur voit : « Voici ce que je vais transmettre ».
  senderPreview    String   @default("")
  version          Int
  isSent           Boolean  @default(false)
  createdAt        DateTime @default(now())

  humlinker Humlinker @relation(fields: [humhlinkerId], references: [id], onDelete: Cascade)

  @@index([humhlinkerId, version(sort: Desc)])
  @@map("drafts")
}

// ─── ChatMessage ──────────────────────────────────────────────────────────────

enum ChatMessageRole {
  user
  ai
  system
}

enum ChatMessageType {
  text
  draft_snapshot
  system
  target_reply
  real_message
}

model ChatMessage {
  id           String          @id @default(uuid())
  humhlinkerId String
  role         ChatMessageRole
  type         ChatMessageType @default(text)
  content      String
  draftId      String?
  createdAt    DateTime        @default(now())

  humlinker Humlinker @relation(fields: [humhlinkerId], references: [id], onDelete: Cascade)

  @@index([humhlinkerId, createdAt(sort: Desc)])
  @@map("chat_messages")
}

// ─── Usage (quotas + suivi des coûts) ─────────────────────────────────────────

enum UsageType {
  /// Reformulation IA dans un humlinker que l'utilisateur a lancé
  ai_reformulation
  /// Reformulation IA d'une réponse, dans un humlinker lancé par quelqu'un d'autre
  ai_reply
  /// Draft envoyé au destinataire (humlinker lancé par l'utilisateur)
  message_sent
  /// Email envoyé à un destinataire non inscrit
  email_to_placeholder
  /// SMS de vérification (OTP) — userId null (avant inscription)
  sms_otp
}

/// Une ligne par action coûteuse : sert à compter les quotas ET à suivre la marge.
model UsageRecord {
  id           String    @id @default(uuid())
  userId       String?
  type         UsageType
  humhlinkerId String?
  inputTokens  Int?
  outputTokens Int?
  /// Coût estimé en micro-dollars (1 $ = 1 000 000)
  costMicroUsd Int       @default(0)
  createdAt    DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, type, createdAt])
  @@index([type, createdAt])
  @@map("usage_records")
}

/// Événements Stripe déjà traités (journal + idempotence).
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_events")
}
